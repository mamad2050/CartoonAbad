<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"

    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp">


    <ir.andromeda.cartoonabad.view.CartoonAbadImageView
        android:id="@+id/iv_animation"
       app:roundedCornerRadius="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:src="@drawable/cartoonabad_icon"
        app:actualImageScaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_height="180dp"
        tools:layout_width="120dp" />


    <TextView
        android:id="@+id/tv_animation_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginVertical="4dp"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"

        android:minLines="1"
        android:textAppearance="?textAppearanceBody1"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/iv_animation"
        app:layout_constraintTop_toBottomOf="@+id/iv_animation"
        tools:text="اتک به تایتان" />

    <TextView
        android:id="@+id/tv_animation_counts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="4dp"

        android:textColor="?android:textColorSecondary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@+id/tv_animation_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_animation_name"
        tools:text="8 فصل - 101 قسمت" />

    <TextView
        android:layout_marginTop="4dp"
        android:id="@+id/tv_animation_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:textColor="?android:textColorSecondary"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/iv_animation"
        app:layout_constraintTop_toBottomOf="@id/tv_animation_counts"
        tools:text="امتیاز : 8.1/10" />

    <TextView
        android:visibility="gone"
        android:textSize="14sp"
        android:textColor="?android:textColorSecondary"
        android:textStyle="bold"
        android:text="به زودی ..."
        android:id="@+id/tv_coming_soon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_animation"
        app:layout_constraintEnd_toEndOf="@+id/iv_animation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_animation" />


</androidx.constraintlayout.widget.ConstraintLayout>