<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="MyNavigationView">
        <item name="android:listDivider">?divider</item>
    </style>

    <style name="NavigationDrawerTextStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/primary_regular</item>
    </style>c

    <style name="MyTextInputLayout" parent="ThemeOverlay.AppCompat">
        <item name="colorPrimary">@color/white</item>
    </style>

    <style name="MyBottomNavigationStyle">

        <item name="colorSurface">@color/black</item>
        <item name="colorPrimary">@color/white</item>

    </style>


    <style name="MyCustomChipStyle" parent="Base.Widget.MaterialComponents.Chip">
        <item name="android:checkable">true</item>
        <item name="chipIconVisible">false</item>
        <item name="checkedIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="android:fontFamily">@font/primary_regular</item>
        <item name="fontFamily">@font/primary_regular</item>
        <item name="android:textColor">@drawable/selector_choice_chip_text</item>
        <item name="chipBackgroundColor">@color/selector_choice_chip_background</item>
        <item name="rippleColor">@color/navy_blue</item>

    </style>


    <style name="MyCustomCheckbox" parent="@style/Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/selector_checkbox</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

</resources>